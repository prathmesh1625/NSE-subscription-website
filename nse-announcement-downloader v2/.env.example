# NSE/BSE announcement scraper — copy to .env and fill in. NEVER commit real values.
SYMBOLS=RELIANCE,TCS,INFY
INTERVAL=30
MAX_RECORDS=50
MAX_PENDING_JOBS=200
WORKERS=4
DOWNLOAD_WORKERS=4
MAX_QUEUE_SIZE=1000
REQUEST_LIMIT=5

# PostgreSQL (ingestion DB)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=nse_ingestion
DB_USER=postgres
DB_PASSWORD=

# Subscription portal DB (read-only) — source of the company list.
# Host/port/user/password default to the DB_* values above.
SUB_DB_NAME=nse_subscription
